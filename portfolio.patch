+          </>
+        )}
+      </div>
+
+      {items.length > 1 && (
+        <div className="flex items-center justify-center gap-2 mt-8">
+          {items.map((_, index) => (
+            <button
+              key={index}
+              type="button"
+              onClick={() => goToSlide(index)}
+              disabled={isTransitioning}
