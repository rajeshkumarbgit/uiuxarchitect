+  const allCaseStudies = useAllCaseStudies();
+  const currentIndex = allCaseStudies.findIndex(cs => cs.slug === caseStudySlug);
+  const caseStudy = allCaseStudies[currentIndex];
+
+  if (!caseStudy) {
