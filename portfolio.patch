+          ]
+        },
+        "design": {
+          "wireframes": "Created 22 screen wireframes across 3 user journey maps. Conducted 5 rounds of rapid prototyping with clickable Figma prototypes tested on actual mobile devices. Validated gesture patterns with 30 users.",
+          "system": "Built a 60-component mobile design system with light/dark themes, 8 typography styles, motion specifications for 12 interaction patterns, and platform-specific adaptations for iOS and Android."
